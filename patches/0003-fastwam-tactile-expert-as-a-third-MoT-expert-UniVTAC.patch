+    @torch.no_grad()
+    def _init_tactile_from_action(self, checkpoint_keys: set[str]) -> None:
+        """
+        UniVTAC: start the tactile expert from the action expert of a checkpoint without a tactile expert (the
+        released FastWAM checkpoints). Its transformer blocks, text, time embeddings already read the video
+        expert's K/V; the tactile input projection, head and stream embedding stay at their initialization.
+        """
+        if not self.config.tactile_keys or not self.config.tactile_init_from_action:
+            return
+        state = self.state_dict()
+        tactile_keys = [key for key in state if ".blocks.tactile." in key or ".mixtures.tactile." in key]
+        if any(key in checkpoint_keys for key in tactile_keys):
+            return
+        copied = 0
+        for key in tactile_keys:
+            source = key.replace(".blocks.tactile.", ".blocks.action.").replace(".mixtures.tactile.", ".mixtures.action.")
+            if source in state and state[source].shape == state[key].shape:
+                state[key].copy_(state[source])
+                copied += 1
+        logging.info(f"Tactile expert: {copied} of {len(tactile_keys)} tensors copied from the action expert.")
+
