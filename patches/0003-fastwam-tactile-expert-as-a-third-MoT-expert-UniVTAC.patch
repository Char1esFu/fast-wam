+def _tactile_from_batch(batch: dict[str, Tensor], config: FastWAMConfig) -> tuple[Tensor, Tensor | None]:
+    """
+    UniVTAC: tactile images `[B, F, S, 3, H, W]` of `config.tactile_keys` (F loaded frames, 1 at inference) and
+    the frames padded past the episode end `[B, F]` (any stream), or None.
+    """
+    frames = []
+    pads = []
+    for key in config.tactile_keys:
+        images = batch[key]
+        frames.append(images.unsqueeze(1) if images.ndim == 4 else images)
+        if f"{key}_is_pad" in batch:
+            pads.append(batch[f"{key}_is_pad"].bool())
+    is_pad = torch.stack(pads).any(dim=0) if pads else None
+    return torch.stack(frames, dim=2), is_pad
+
