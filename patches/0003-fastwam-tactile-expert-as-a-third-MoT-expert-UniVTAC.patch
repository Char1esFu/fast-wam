+    def _forward_experts_cached(
+        self,
+        tokens_all: dict[str, torch.Tensor],
+        freqs_all: dict[str, torch.Tensor],
+        t_mod_all: dict[str, torch.Tensor],
+        context_all: dict[str, dict | None],
+        k_video: torch.Tensor,
+        v_video: torch.Tensor,
+        attention_mask: torch.Tensor,
+    ) -> dict[str, torch.Tensor]:
+        """
+        One layer of the non-video experts (UniVTAC: action and tactile) against this layer's cached video K/V:
+        their queries attend to [video | experts] keys under the rows of the joint mask.
+        """
+        names = list(tokens_all)
+        q_chunks, k_chunks, v_chunks, cached, seq_lens = [], [k_video], [v_video], {}, []
+        for name in names:
+            q, k, v, residual_x, gate_msa, shift_mlp, scale_mlp, gate_mlp, use_gc = self._build_expert_attention_io(
+                name, tokens_all[name], freqs_all[name], t_mod_all[name]
+            )
+            q_chunks.append(q)
+            k_chunks.append(k)
+            v_chunks.append(v)
+            seq_lens.append(tokens_all[name].shape[1])
+            cached[name] = (residual_x, gate_msa, shift_mlp, scale_mlp, gate_mlp, use_gc)
+        mixed = self._mixed_attention(
